# Copy to .env (or run `make env` to generate one with random secrets).
# Every value marked REQUIRED must be set; services refuse to start otherwise.

APP_ENV=development
LOG_LEVEL=info

# REQUIRED. At least 32 characters. Shared by all services to sign/verify tokens.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# REQUIRED. Postgres superuser for the local stack.
POSTGRES_USER=vendora
POSTGRES_PASSWORD=change-me-postgres-password

# REQUIRED. Redis password (carts, product cache, rate limits).
REDIS_PASSWORD=change-me-redis-password

# Optional admin account created/promoted at user-service startup.
ADMIN_EMAIL=admin@vendora.local
ADMIN_PASSWORD=change-me-admin-password

# Allowed browser origins for CORS (comma separated). Empty = no CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Gateway rate limits (requests per minute per user, or per IP when anonymous).
# Development defaults are generous so the e2e suite can run; use ~10-20 for
# the auth limit in production.
RATE_LIMIT_AUTH_PER_MIN=200
RATE_LIMIT_WRITE_PER_MIN=600
RATE_LIMIT_READ_PER_MIN=3000

# Checkout saga timeouts.
ORDER_PAYMENT_TIMEOUT=15m
ORDER_PENDING_TIMEOUT=2m

# Email. With SMTP_ENABLED=false emails are logged (recipient redacted).
SMTP_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@vendora.local
